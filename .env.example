# Documentation only: flintd does not load this file automatically.
# Use `export FLINT_STORE=.local/store` or pass --store explicitly.
FLINT_STORE=.local/store

# Optional companion client for the sync journey. Leave unset to skip it.
# FLINT_BIN=/absolute/path/to/flint

# Auth keys are supplied by --auth-key=/outside/repository/auth.key.
# Never put secret values in this file or in environment templates.
